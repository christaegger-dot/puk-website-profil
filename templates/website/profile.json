{
  "systemVersion": "1.10.1",
  "id": "website",
  "name": "Website",
  "status": "system-defined-web-profile",
  "authority": {
    "type": "measured-and-system-defined",
    "normativeSource": "templates/website/profile.json",
    "scope": "Websites und browserbasierte Informationsangebote innerhalb dieses Design Systems",
    "basis": [
      "PUK Corporate-Design-Manual",
      "am bestehenden PUK-Webauftritt gemessene app.css-Werte",
      "Webtokens und öffentliche Komponenten des Design Systems"
    ],
    "officialOfficeMediaClaim": false
  },
  "sourceBoundary": "Eigenständiges digitales Systemprofil. profile.json ist die verbindliche Sollquelle für die Website-Erstellung im Design System; es ist keine officeatwork-Büromedien-Vorlage und keine vollständige technische Spezifikation des produktiven PUK-Webauftritts.",
  "viewports": {
    "narrow": {
      "widthPx": 360,
      "heightPx": 800
    },
    "medium": {
      "widthPx": 768,
      "heightPx": 900
    },
    "wide": {
      "widthPx": 1440,
      "heightPx": 1000
    }
  },
  "layout": {
    "containerMaximumPx": 1200,
    "contentMeasureCh": 68,
    "minimumInlineGutterPx": 20,
    "maximumInlineGutterPx": 48,
    "horizontalOverflowAllowed": false,
    "wideContainerCentered": true
  },
  "typography": {
    "family": "Rubik",
    "bodyMaximumPx": 21,
    "headingMaximumPx": {
      "h1": 114,
      "h2": 57,
      "h3": 40
    },
    "fluidHeadingsRequired": true,
    "bodyMeasureMinimumCh": 45,
    "bodyMeasureMaximumCh": 75
  },
  "semantics": {
    "languageRequired": true,
    "uniqueTitleRequired": true,
    "metaDescriptionRequired": true,
    "skipLinkRequired": true,
    "exactlyOneMainRequired": true,
    "navigationLabelRequired": true,
    "activeNavigationUsesAriaCurrent": true,
    "exactlyOneH1Required": true
  },
  "navigation": {
    "minimumTargetPx": 44,
    "minimumTargetScope": [
      "buttons",
      "navigation links",
      "standalone action links"
    ],
    "inlineTextLinks": {
      "layout": "inline-with-natural-line-height",
      "minimumHeightRequired": false,
      "minimumSpacingRequired": false,
      "wcag22Reference": "SC 2.5.8 inline target exception"
    },
    "narrowMode": "wrapping-grid",
    "emergencyLinkVisuallyDistinct": false,
    "colorAloneForActiveStateAllowed": false
  },
  "content": {
    "tokensInsteadOfColorLiterals": true,
    "faviconRequiredOnEveryPage": true,
    "cardsUseListSemantics": true,
    "figuresRequireTextAlternative": true,
    "tablesRequireCaption": true,
    "pageSequenceHasPreviousNextNavigation": true,
    "longformPattern": {
      "registry": "templates/website/longform-pattern.json",
      "styles": "tokens/web-longform.css",
      "referenceDirectory": "templates/website/longform",
      "status": "validated-in-three-synthetic-contexts",
      "humanComprehensionTested": false
    }
  },
  "safetyAccess": {
    "status": "editorial-choice-per-topic",
    "defaultVariant": "none",
    "selectionQuestion": "Sind Krisenkontakte für das konkrete Thema und die Leserfrage hilfreich?",
    "automaticInsertion": false,
    "phoneNumbersAllowed": true,
    "telephoneLinksAllowed": true,
    "variants": {
      "none": {
        "useFor": [
          "Standardvorlagen ohne thematisch gewählte Krisenkontakte"
        ]
      },
      "content": {
        "useFor": [
          "bewusst gewählte Kriseninformationen im passenden Inhaltsabschnitt"
        ],
        "placement": "redaktionell je Thema entscheiden",
        "visualPriority": "entsprechend der Bedeutung für dieses Material"
      },
      "direct": {
        "useFor": [
          "bewusst gewählter Akutpfad als Hauptaufgabe einer Seite"
        ],
        "placement": "vom konkreten Seitenziel abhängig",
        "visualPriority": "nur bei ausdrücklichem thematischem Entscheid hoch"
      },
      "persistent-subdued": {
        "useFor": [
          "ausdrücklich gewählte ergänzende Kontaktinformation"
        ],
        "placement": "geeigneter ruhiger Bereich",
        "visualPriority": "sekundär"
      },
      "responsibility": {
        "useFor": [
          "ausdrücklich konfigurierter optionaler Zuständigkeitstext"
        ],
        "placement": "nach dokumentiertem Einsatzentscheid"
      }
    },
    "mustNot": [
      "Notfallnummern automatisch ergänzen oder hervorheben",
      "eine Diagnose allein als Auslöser einer Krisenrubrik verwenden",
      "Kontaktdaten ohne Prüfung ihrer Richtigkeit und Aktualität erfinden"
    ],
    "configurationNote": "Die Varianten beschreiben wählbare Darstellungsmuster und erzeugen selbst keinen Inhalt. Im Starter sind responsibility und responsibility.inline ausdrücklich optionale Textfelder; themenbezogene Kontakte können direkt im Inhalt stehen."
  },
  "applicationPatterns": {
    "registry": "templates/website/application-patterns.json",
    "referenceDirectory": "templates/website/applications",
    "contentSchema": "templates/website/application-content.schema.json",
    "contentExample": "templates/website/applications/application-content.example.json",
    "requiredIds": [
      "situation-navigator",
      "contact-pathfinder",
      "conversation-guide",
      "service-finder"
    ],
    "rules": {
      "diagnosisOrAutomatedTriageAllowed": false,
      "onePrimaryNextStepRequired": true,
      "sourceOwnerAndReviewDateRequiredForOperationalContent": true,
      "structuredContentContractRequired": true,
      "criticalInformationOnlyInDialogAllowed": false,
      "resultStatusProgrammaticallyExposed": true,
      "sensitiveInputPersistenceDefault": "off"
    }
  },
  "formsAndData": {
    "labelsRequired": true,
    "errorSummaryRequiredForMultiFieldErrors": true,
    "sensitiveInputPersistenceDefault": "off",
    "storagePolicyFile": "website-data-policy.json",
    "storagePolicyTemplate": "templates/website/website-data-policy.example.json",
    "storageNoticeMarker": "data-storage-notice",
    "storageDeleteMarker": "data-storage-delete",
    "browserStorageRequires": [
      "transparent notice before entry",
      "explicit retention scope",
      "visible delete action",
      "privacy review",
      "no transmission claim verified"
    ]
  },
  "qualityGates": {
    "viewports": [
      360,
      768,
      1440
    ],
    "reflowWidthPx": 320,
    "textResizePercent": 200,
    "reflowEquivalentZoomPercent": 400,
    "criticalBreakpointsRequired": true,
    "keyboard": true,
    "focusNotObscured": true,
    "contrastAgainstWcag22AA": true,
    "screenreader": "human-test-required-before-production",
    "screenreaderEvidenceFile": "website-screenreader-test.json",
    "screenreaderEvidenceTemplate": "templates/website/website-screenreader-test.example.json",
    "screenreaderMinimumRuns": 2,
    "allPagesProjectGateRequired": true,
    "allLocalResourcesMustResolve": true,
    "runtimeDependenciesMustBeLocal": true,
    "applicationPatternsGateRequired": true,
    "browserErrors": 0,
    "externalRequests": 0
  },
  "releaseHygiene": {
    "referenceContentIncluded": false,
    "rawClaudeProjectExportIsReleaseArtifact": false,
    "canonicalReleaseCommands": [
      "npm run release",
      "npm run release:build -- <new-target-directory>"
    ],
    "forbiddenPathPatterns": [
      "uploads/",
      "_src/",
      "case-data/",
      "Stress und Stressbewältigung",
      "Stress und Stressbewaeltigung"
    ]
  },
  "profileVersion": "2026.10.4"
}
