{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pukzh.example/design-system/application-content.schema.json",
  "title": "PUK Website-Anwendungsdaten",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "contactPaths", "services"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "contactPaths": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/contactPath" }
    },
    "services": {
      "type": "array",
      "items": { "$ref": "#/$defs/service" }
    }
  },
  "$defs": {
    "governance": {
      "type": "object",
      "required": ["contentOwner", "reviewedAt", "sourceStatus"],
      "properties": {
        "contentOwner": { "type": "string", "minLength": 2 },
        "reviewedAt": { "type": "string", "format": "date" },
        "sourceStatus": { "enum": ["verified", "example", "expired"] }
      }
    },
    "contactPath": {
      "allOf": [
        { "$ref": "#/$defs/governance" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "level", "title", "description", "actionLabel", "actionHref", "contentOwner", "reviewedAt", "sourceStatus"],
          "properties": {
            "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
            "level": { "enum": ["orientation", "urgent", "emergency"] },
            "title": { "type": "string", "minLength": 4 },
            "description": { "type": "string", "minLength": 10 },
            "actionLabel": { "type": "string", "minLength": 4 },
            "actionHref": { "type": "string", "minLength": 1 },
            "contentOwner": { "type": "string", "minLength": 2 },
            "reviewedAt": { "type": "string", "format": "date" },
            "sourceStatus": { "enum": ["verified", "example", "expired"] }
          }
        }
      ]
    },
    "service": {
      "allOf": [
        { "$ref": "#/$defs/governance" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "title", "category", "description", "audience", "access", "jurisdiction", "costStatus", "availabilityStatus", "searchTerms", "contentOwner", "reviewedAt", "sourceStatus"],
          "properties": {
            "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
            "title": { "type": "string", "minLength": 4 },
            "category": { "type": "string", "minLength": 2 },
            "description": { "type": "string", "minLength": 10 },
            "audience": { "type": "string", "minLength": 2 },
            "access": { "type": "string", "minLength": 2 },
            "jurisdiction": { "type": "string", "minLength": 2 },
            "costStatus": { "type": "string", "minLength": 2 },
            "availabilityStatus": { "enum": ["verified", "unknown", "expired"] },
            "searchTerms": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 2 } },
            "contentOwner": { "type": "string", "minLength": 2 },
            "reviewedAt": { "type": "string", "format": "date" },
            "expiresAt": { "type": "string", "format": "date" },
            "sourceStatus": { "enum": ["verified", "example", "expired"] }
          }
        }
      ]
    }
  }
}
